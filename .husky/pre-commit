#!/usr/bin/env sh
# 1. ESLint + auto-fix sobre archivos staged
npx lint-staged || exit 1

# 2. TypeScript check del directorio api/ (Edge Functions Vercel)
#    El tsconfig raiz NO incluye api/, asi que un error TS aqui solo
#    aparece en el deploy. Este chequeo lo cazamos antes de push.
#    Filtramos errores de tests preexistentes para no bloquear commits
#    en archivos no relacionados.
echo "🔍 Chequeando types de api/ (Vercel Edge Functions)..."
ERRORS=$(npx tsc --project api/tsconfig.json --noEmit 2>&1 | grep -E "^api/" | grep -vE "test\.ts|__tests__|_player-report\.ts" || true)
if [ -n "$ERRORS" ]; then
  echo "❌ Errores TS en api/ que romperian el deploy de Vercel:"
  echo "$ERRORS"
  exit 1
fi
echo "✅ api/ types OK"

# 3. Auditoría de procedencia de métricas (arnés de honestidad — goal vitas).
#    Reutiliza el hook completo de .githooks/pre-commit (detección de cambios +
#    exit 0/2 pasa, otro = bloquea). NO cambiamos core.hooksPath: eso desactivaría
#    Husky y se revertiría en el próximo `npm install`. Integrarlo aquí es estable.
if [ -f .githooks/pre-commit ]; then
  bash .githooks/pre-commit || exit 1
fi
