# ═══════════════════════════════════════════════════════════════════════════════
# VITAS · Football Intelligence — Environment Variables
# Copy to .env (dev) or configure in Vercel dashboard (production)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
GEMINI_API_KEY=AI...

# ── Bunny CDN (Video Hosting) ────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=...
BUNNY_CDN_HOSTNAME=vz-xxx.b-cdn.net
VITE_BUNNY_CDN_HOSTNAME=vz-xxx.b-cdn.net
BUNNY_STORAGE_ZONE=vitas-storage
BUNNY_STORAGE_API_KEY=...
BUNNY_STORAGE_CDN_URL=https://vitas-storage.b-cdn.net

# ── Stripe (Payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_CLUB_PRICE_ID=price_...

# ── Push Notifications ───────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@vitas.app

# ── External APIs ─────────────────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=VITAS <noreply@yourdomain.com>

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Security ──────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret
SHARE_SECRET=your-share-secret
ALLOWED_ORIGIN=https://futuro-club.vercel.app
TURNSTILE_SECRET_KEY=...

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=vitas

# ── Modal (GPU Processing — optional, Phase 2) ───────────────────────────────
# MODAL_PIPELINE_URL=https://your-modal-endpoint.modal.run
# MODAL_AUTH_TOKEN=...

# ── Roboflow (Legacy — replaced by local YOLO) ───────────────────────────────
