# ═══════════════════════════════════════════════════════════════════════════════
# VITAS · Football Intelligence — Environment Variables
# Copy to .env (dev) or configure in Vercel dashboard (production)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
GEMINI_API_KEY=AI...

# ── Bunny CDN (Video Hosting) ────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=...
BUNNY_CDN_HOSTNAME=vz-xxx.b-cdn.net
VITE_BUNNY_CDN_HOSTNAME=vz-xxx.b-cdn.net
BUNNY_STORAGE_ZONE=vitas-storage
BUNNY_STORAGE_API_KEY=...
BUNNY_STORAGE_CDN_URL=https://vitas-storage.b-cdn.net

# ── Stripe (Payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_CLUB_PRICE_ID=price_...

# ── Push Notifications ───────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@vitas.app

# ── External APIs ─────────────────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=VITAS <noreply@yourdomain.com>

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Security ──────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret
SHARE_SECRET=your-share-secret
ALLOWED_ORIGIN=https://futuro-club.vercel.app
TURNSTILE_SECRET_KEY=...

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=vitas

# ── Budget Guard (tripwire anti runaway-cost) ────────────────────────────────
# Tope de gasto IA mensual GLOBAL en USD. Al superarlo, el backend CORTA las
# llamadas de pago (Claude/Gemini/Modal) → 429 BUDGET_EXCEEDED. Defensa en
# profundidad; el hard-cap REAL se fija en los dashboards de Modal/Anthropic.
# Vacío/ausente → default 10. Un número positivo = ese tope. <=0 DESACTIVA el tripwire.
# Requiere la migración 054 (tabla ai_spend_ledger). Consumido por api/_lib/budgetGuard.ts
GLOBAL_MONTHLY_BUDGET_USD=10

# ── Modal (GPU — player/ball tracking para Táctico/Set-Pieces) ───────────────
# El análisis principal de vídeo usa Gemini (GEMINI_API_KEY). Modal cubre el
# TRACKING de jugadores/balón para el heatmap táctico y set-pieces.
# Consumido por api/coaching/_track-players.ts y api/tactical/_compute-from-video.ts
MODAL_TRACK_URL=https://your-modal-endpoint.modal.run
MODAL_API_KEY=...

# ── Telegram (Coach Copilot bot) ─────────────────────────────────────────────
# Consumido por api/telegram/webhook.ts + connect.ts.
# Registra el webhook con: npx tsx scripts/telegram-setup-webhook.ts --set
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_BOT_USERNAME=vitas_coach_bot

# ── Internal API (llamadas server-to-server: orchestrator, crons) ────────────
# INTERNAL_API_TOKEN autoriza las llamadas internas entre Edge Functions
# (fallback a CRON_SECRET si no se define). También aceptado por withHandler
# como token de servicio (allowServiceToken). VITAS_PUBLIC_URL es la base para
# construir esas llamadas (fallback a VERCEL_URL / futuro-club.vercel.app).
INTERNAL_API_TOKEN=your-internal-token
VITAS_PUBLIC_URL=https://futuro-club.vercel.app
VITAS_API_BASE_URL=https://futuro-club.vercel.app
# Opcional: alertas de retención/queue a Slack
SLACK_RETENTION_WEBHOOK=

# ── Roboflow (Legacy — replaced by local YOLO) ───────────────────────────────
# ROBOFLOW_API_KEY=...
# ROBOFLOW_WORKSPACE=...
# ROBOFLOW_PROJECT=...
